+// stun60 (local patch): apply CPU clock scales (same as the Slider Controls overclock) from the
+// environment, e.g. STUN60_CLOCK="maincpu=4,gsp=4,adsp=6". Unset = stock clocks.
+void stunrun_board_device_state::device_reset()
+{
+	harddriv_state::device_reset();
+	const char *env = std::getenv("STUN60_CLOCK");
+	if (!env || !*env)
+		return;
+	std::string spec(env);
+	size_t pos = 0;
+	while (pos < spec.size())
+	{
+		size_t end = spec.find(',', pos);
+		if (end == std::string::npos) end = spec.size();
+		std::string item = spec.substr(pos, end - pos);
+		pos = end + 1;
+		size_t eq = item.find('=');
+		if (eq == std::string::npos) continue;
+		std::string name = item.substr(0, eq);
+		double scale = std::atof(item.c_str() + eq + 1);
+		if (scale < 0.1 || scale > 20.0) continue;
+		device_t *dev = nullptr;
+		if (name == "maincpu") dev = m_maincpu.target();
+		else if (name == "gsp") dev = m_gsp.target();
+		else if (name == "adsp") dev = m_adsp.target();
+		if (dev)
+		{
+			dev->set_clock_scale(scale);
+			std::fprintf(stderr, "stun60: %s clock x%.2f\n", name.c_str(), scale);
+		}
+	}
+}
