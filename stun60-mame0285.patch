+// stun60 (local patch): bulk work for the interpolation script, which would be slow in Lua.
+//   1 SNAP    P0=slot      save ADSP data RAM words 0-0x1FFE
+//   2 RESTORE P0=slot      write back the words that differ
+//   3 STORE   P0=bank P1=k copy a finished ADSP output list (count word, words.., FFFF) -> store k; result = count or 0
+//   4 TAIL    P0:P1=GSP bit address, P2=length   capture the HUD tail that follows the 3D block
+//   5 BUILD   P0=k P1:P2=GSP bit address         write 0x7000, store k, then the tail; result = count
+//   6 COMPARE P0=k P1:P2=GSP bit address         result = number of store words equal to the list there
+void harddriv_state::s60_command(uint16_t cmd)
+{
+	address_space &dsp = m_adsp->space(AS_DATA);
+	address_space &gsp = m_gsp->space(AS_PROGRAM);
+	const uint32_t addr = (uint32_t(m_s60_param[1]) << 16) | m_s60_param[2];
+	m_s60_result = 0;
+	switch (cmd)
+	{
+	case 1: {
+		auto &v = m_s60_snap[m_s60_param[0] & 15];
+		v.resize(0x1fff);
+		for (int i = 0; i < 0x1fff; i++) v[i] = dsp.read_word(i);
+		m_s60_result = 1;
+		break; }
+	case 2: {
+		auto &v = m_s60_snap[m_s60_param[0] & 15];
+		if (v.size() != 0x1fff) break;
+		for (int i = 0; i < 0x1fff; i++)
+			if (dsp.read_word(i) != v[i]) dsp.write_word(i, v[i]);
+		m_s60_result = 1;
+		break; }
+	case 3: {
+		const uint16_t *src = &m_som_memory[(m_s60_param[0] & 1) * 0x2000];
+		const uint16_t n = src[0];
+		auto &v = m_s60_store[m_s60_param[1] & 3];
+		v.clear();
+		if (n == 0 || n > 0x1ffe || src[n] != 0xffff) break;
+		v.assign(src + 1, src + 1 + n);
+		m_s60_result = n;
+		break; }
+	case 4: {
+		const uint32_t a = (uint32_t(m_s60_param[0]) << 16) | m_s60_param[1];
+		const int len = std::min<int>(m_s60_param[2], 4000);
+		m_s60_tail.resize(len);
+		for (int i = 0; i < len; i++) m_s60_tail[i] = gsp.read_word(a + 16 * i);
+		m_s60_result = len;
+		break; }
+	case 5: {
+		const auto &v = m_s60_store[m_s60_param[0] & 3];
+		if (v.empty()) break;
+		gsp.write_word(addr, 0x7000);
+		for (size_t i = 0; i < v.size(); i++) gsp.write_word(addr + 16 * (i + 1), v[i]);
+		const uint32_t q = addr + 16 * (v.size() + 1);
+		for (size_t i = 0; i < m_s60_tail.size(); i++) gsp.write_word(q + 16 * i, m_s60_tail[i]);
+		m_s60_result = v.size();
+		break; }
+	case 6: {
+		const auto &v = m_s60_store[m_s60_param[0] & 3];
+		int same = 0;
+		for (size_t i = 0; i < v.size(); i++) if (gsp.read_word(addr + 16 * (i + 1)) == v[i]) same++;
+		m_s60_result = same;
+		break; }
+	}
 }
 
