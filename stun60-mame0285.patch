+// stun60 HD: FNV-1a over the reference colours of the pens an image uses (identifies a palette variant)
+static uint32_t s60_palkey(const uint8_t (&ref)[256][3], const std::vector<uint8_t> &used)
+{
+	uint32_t h = 2166136261u;
+	for (uint8_t p : used)
+		for (int c = 0; c < 3; c++) h = (h ^ ref[p][c]) * 16777619u;
+	return h;
+}
+
+static std::vector<uint8_t> s60_used_pens(const std::vector<uint8_t> &pens)
+{
+	bool u[256] = { false };
+	for (uint8_t p : pens) u[p] = true;
+	std::vector<uint8_t> r;
+	for (int i = 0; i < 256; i++) if (u[i]) r.push_back(uint8_t(i));
+	return r;
+}
+
+/*************************************
+ *
+ *  stun60 HD (local patch): redraw the S.T.U.N. Runner 3D scene at a higher resolution.
+ *
+ *  The GSP draws each display list into a frame buffer; the list's 3D block (opcode 7) holds
+ *  screen-space polygons whose edges are given as 16.16 slopes, so they can be rasterized at any
+ *  resolution. A second screen ("hdscreen", STUN60_HD="SXxSY", default 3x5) shows each frame as:
+ *    - every low-res pixel scaled up SX x SY (background bitmaps, HUD, text),
+ *    - the 3D polygons redrawn at full resolution on top, except where something was drawn over
+ *      the 3D scene (a low-res pixel whose colour doesn't match the polygon that should be there).
+ *  Low-res raster rules match the GSP exactly (verified pixel-exact offline, see re-probes/col).
+ *
+ *************************************/
+
+void harddriv_state::hd_config(machine_config &config)
+{
+	const char *env = std::getenv("STUN60_HD");
+	if (!env || !*env || !std::strcmp(env, "0"))
+		return;
+	int sx = 3, sy = 5;
+	if (std::sscanf(env, "%dx%d", &sx, &sy) != 2 || sx < 1 || sx > 8 || sy < 1 || sy > 8)
+		sx = 3, sy = 5;
+	m_hd_sx = sx;
+	m_hd_sy = sy;
+	// keep the original screen updating even when only the HD screen is in view (we read its pixels)
+	m_screen->set_video_attributes(VIDEO_UPDATE_BEFORE_VBLANK | VIDEO_ALWAYS_UPDATE);
+	SCREEN(config, m_hdscreen, SCREEN_TYPE_RASTER);
+	m_hdscreen->set_refresh_hz(5000000.0 * 2 / (317 * 2 * 262));
+	m_hdscreen->set_size(512 * sx, 240 * sy);
+	m_hdscreen->set_visarea(0, 512 * sx - 1, 0, 240 * sy - 1);
+	m_hdscreen->set_screen_update(FUNC(harddriv_state::hd_screen_update));
+	// composed only while the HD screen is in view, unless a headless test asks for it
+	m_hd_always = std::getenv("STUN60_HDALWAYS") || std::getenv("STUN60_HDDEBUG");
+	if (m_hd_always)
+		m_hdscreen->set_video_attributes(VIDEO_ALWAYS_UPDATE);
+}
+
+void harddriv_state::hd_start()
+{
+	if (!m_hd_sx || !m_hdscreen)
+		return;
+	m_hd_lowres.assign(512 * 256, 0);
+	m_hd_done.assign(512 * 256, 0);
+	m_hd_bitmap.allocate(512 * m_hd_sx, 240 * m_hd_sy);
+	m_hd_bitmap.fill(0xff000000);
+	m_hd_back.allocate(512 * m_hd_sx, 240 * m_hd_sy);
+	m_hd_back.fill(0xff000000);
+	m_hd_sync = std::getenv("STUN60_HDSYNC") != nullptr;
+	machine().add_notifier(MACHINE_NOTIFY_EXIT, machine_notify_delegate(&harddriv_state::hd_stop, this));
+	if (const char *lw = std::getenv("STUN60_HDLINE"))
+		m_hd_linew = std::clamp(std::atof(lw), 0.5, 8.0);
+	m_hd_always = std::getenv("STUN60_HDALWAYS") || std::getenv("STUN60_HDDEBUG");
+	if (const char *aa = std::getenv("STUN60_HDAA"))
+		m_hd_aa = std::clamp(std::atoi(aa), 1, 4);
+	if (const char *x = std::getenv("STUN60_HDXBR"))
+		m_hd_xbr = std::atoi(x) != 0;
+	m_hd_threads = std::clamp(int(std::thread::hardware_concurrency()) / 2, 1, 4);
+	if (const char *nt = std::getenv("STUN60_HDTHREADS"))
+		m_hd_threads = std::clamp(std::atoi(nt), 1, 16);
+	std::fprintf(stderr, "stun60: HD screen %dx%d (x%d, x%d), polygon anti-aliasing %dx%d, %d threads\n", 512 * m_hd_sx, 240 * m_hd_sy,
+			m_hd_sx, m_hd_sy, m_hd_aa, m_hd_aa, m_hd_threads);
+	address_space &gsp = m_gsp->space(AS_PROGRAM);
+	// FFF71680: set when the GSP has finished drawing a list, cleared at the vblank flip that shows it
+	m_hd_tap = gsp.install_write_tap(0xfff71680, 0xfff7168f, "s60hd",
+			[this] (offs_t offset, u16 &data, u16 mem_mask)
+			{
+				if (data)
+				{
+					hd_parse_list();
+					if (!m_hd_optap_on && (m_hd_build || !m_hd_bgs.empty()))
+					{
+						m_hd_optap_on = true;
+						machine().scheduler().synchronize(timer_expired_delegate(FUNC(harddriv_state::hd_install_optap), this));
+					}
+				}
+				else if (m_hd_pending)
+				{
+					m_hd_shown = std::move(m_hd_pending);
+					m_hd_pending.reset();
+				}
+			});
+	hd_load_pack();
+	hd_start_builder();
+}
+
+// Record display-list op 8 blits. Installed once the game runs (a tap installed in device_start is lost when the
+// driver later remaps the GSP RAM), from the scheduler (not from inside another tap).
+void harddriv_state::hd_install_optap(s32 param)
+{
+	address_space &gsp = m_gsp->space(AS_PROGRAM);
+	// the display-list walker reads its jump table (FFF470E0, one long per opcode) with the command word in
+	// A4 and the argument pointer in A5: record op 8 (bitmap blit: x, y, flags, address hi, lo)
+	m_hd_optap = gsp.install_read_tap(0xfff470e0, 0xfff472df, "s60hdop",
+				[this] (offs_t offset, u16 &data, u16 mem_mask)
+				{
+					if (offset != 0xfff470e0 + 8 * 32)
+						return;
+					const uint32_t a4 = m_gsp->state_int(TMS34010_A4), a5 = m_gsp->state_int(TMS34010_A5);
+					if (((a4 >> 12) & 15) != 8 || m_hd_blits_cur.size() >= 64)
+						return;
+					address_space &sp = m_gsp->space(AS_PROGRAM);
+					s60hd_blit b;
+					b.x = int16_t(sp.read_word(a5)); b.y = int16_t(sp.read_word(a5 + 16));
+					b.flags = sp.read_word(a5 + 32);
+					b.addr = (uint32_t(sp.read_word(a5 + 48)) << 16) | sp.read_word(a5 + 64);
+					b.w = b.h = 0; b.key = 0;
+					m_hd_blits_cur.push_back(b);
+				});
+	m_hd_optap_on = true;
+	std::fprintf(stderr, "stun60: HD background blit recorder on\n");
+}
+
+namespace {
+
+// HD pack file: "S60BG04", key, w, h, SX, SY, the reference palette, then (zlib) the HD image as planes: red, green,
+// blue, pen. "S60BG03" (older, uncompressed: ARGB words, then pens) is still read; the builder rewrites those as 04.
+bool s60_read_bg(const std::filesystem::path &path, int want_sx, int want_sy, uint32_t &key, harddriv_state::s60hd_bg &bg, bool *old = nullptr)
+{
+	std::ifstream f(path, std::ios::binary);
+	char magic[8]; uint16_t w, h, sx, sy;
+	if (!f.read(magic, 8)) return false;
+	const bool v3 = !std::memcmp(magic, "S60BG03", 8), v4 = !std::memcmp(magic, "S60BG04", 8);
+	if (!v3 && !v4) return false;                                          // older packs are rebuilt
+	if (old) *old = v3;
+	f.read(reinterpret_cast<char *>(&key), 4); f.read(reinterpret_cast<char *>(&w), 2); f.read(reinterpret_cast<char *>(&h), 2);
+	f.read(reinterpret_cast<char *>(&sx), 2); f.read(reinterpret_cast<char *>(&sy), 2);
+	if (!f || (want_sx && (sx != want_sx || sy != want_sy)) || !w || !h || w > 1024 || h > 512) return false;
+	bg.w = w; bg.h = h;
+	f.read(reinterpret_cast<char *>(bg.ref), sizeof(bg.ref));
+	const size_t n = size_t(w) * sx * h * sy;
+	bg.rgb.resize(n); bg.pen.resize(n);
+	if (v3)
+	{
+		f.read(reinterpret_cast<char *>(bg.rgb.data()), n * 4);
+		f.read(reinterpret_cast<char *>(bg.pen.data()), n);
+		return bool(f);
+	}
+	uint32_t clen = 0;
+	f.read(reinterpret_cast<char *>(&clen), 4);
+	if (!f || clen > n * 5) return false;
+	std::vector<uint8_t> c(clen), raw(n * 4);
+	if (!f.read(reinterpret_cast<char *>(c.data()), clen)) return false;
+	uLongf rl = uLongf(raw.size());
+	if (uncompress(raw.data(), &rl, c.data(), clen) != Z_OK || rl != raw.size()) return false;
+	for (size_t i = 0; i < n; i++)
+		bg.rgb[i] = 0xff000000 | (uint32_t(raw[i]) << 16) | (uint32_t(raw[n + i]) << 8) | raw[2 * n + i];
+	std::memcpy(bg.pen.data(), &raw[3 * n], n);
+	return true;
+}
+
+// write a temporary file, then rename it, so a half-written pack file is never loaded
+bool s60_write_bg(const std::filesystem::path &path, uint32_t key, int sx, int sy, const harddriv_state::s60hd_bg &bg)
+{
+	const size_t n = bg.pen.size();
+	std::vector<uint8_t> raw(n * 4);
+	for (size_t i = 0; i < n; i++)
+	{
+		const uint32_t c = bg.rgb[i];
+		raw[i] = uint8_t(c >> 16); raw[n + i] = uint8_t(c >> 8); raw[2 * n + i] = uint8_t(c);
+	}
+	std::memcpy(&raw[3 * n], bg.pen.data(), n);
+	uLongf cl = compressBound(uLong(raw.size()));
+	std::vector<uint8_t> c(cl);
+	if (compress2(c.data(), &cl, raw.data(), uLong(raw.size()), 6) != Z_OK) return false;
+	const std::filesystem::path tmpp = path.string() + ".tmp";
+	{
+		std::ofstream o(tmpp, std::ios::binary);
+		const uint16_t hdr[4] = { bg.w, bg.h, uint16_t(sx), uint16_t(sy) };
+		const uint32_t clen = uint32_t(cl);
+		o.write("S60BG04", 8); o.write(reinterpret_cast<const char *>(&key), 4); o.write(reinterpret_cast<const char *>(hdr), 8);
+		o.write(reinterpret_cast<const char *>(bg.ref), sizeof(bg.ref));
+		o.write(reinterpret_cast<const char *>(&clen), 4);
+		o.write(reinterpret_cast<const char *>(c.data()), cl);
+		if (!o) return false;
+	}
+	std::error_code ec;
+	std::filesystem::rename(tmpp, path, ec);
+	return !ec;
+}
+
+} // anonymous namespace
+
+// Load the HD background pack: every .s60bg file in $STUN60_HDPACK made for this SX x SY.
+void harddriv_state::hd_load_pack()
+{
+	const char *dir = std::getenv("STUN60_HDPACK");
+	if (!dir || !*dir)
+		return;
+	std::error_code ec;
+	for (const auto &e : std::filesystem::directory_iterator(dir, ec))
+	{
+		if (e.path().extension() != ".s60bg")
+			continue;
+		uint32_t key; s60hd_bg bg;
+		if (!s60_read_bg(e.path(), m_hd_sx, m_hd_sy, key, bg)) continue;
+		hd_add_bg(key, std::move(bg));
+	}
+	size_t n = 0;
+	for (const auto &kv : m_hd_bgs) n += kv.second.size();
+	std::fprintf(stderr, "stun60: HD background pack %s: %d images\n", dir, int(n));
+}
+
+void harddriv_state::hd_add_bg(uint32_t key, s60hd_bg &&bg)
+{
+	bg.used = s60_used_pens(bg.pen);
+	bg.palkey = s60_palkey(bg.ref, bg.used);
+	if (bg.w == 512 && (bg.h == 240 || bg.h == 208 || bg.h == 32) && std::find(m_hd_fskeys.begin(), m_hd_fskeys.end(), key) == m_hd_fskeys.end())
+		m_hd_fskeys.push_back(key);
+	std::vector<s60hd_bg> &v = m_hd_bgs[key];
+	for (s60hd_bg &o : v)
+		if (o.palkey == bg.palkey && o.w == bg.w && o.h == bg.h) { o = std::move(bg); return; }
+	v.push_back(std::move(bg));
+}
+
+// Parse the list the GSP just drew (its address is at FFF77F30/40) into polygons.
+void harddriv_state::hd_parse_list()
+{
+	address_space &gsp = m_gsp->space(AS_PROGRAM);
+	auto w = [&gsp] (uint32_t a) -> uint16_t { return gsp.read_word(a); };
+	const uint32_t ptr = w(0xfff77f30) | (uint32_t(w(0xfff77f40)) << 16);
+	auto list = std::make_shared<s60hd_list>();
+	m_hd_lists++;
+	// list flags the GSP drew this list with (copied from the list header): bit 3 = every polygon as a wireframe,
+	// bit 5 = wireframes without their right edges
+	list->gflags = w(0xfff77e60);
+
+	for (int k = 0; k < 1200; k++)
+	{
+		const uint32_t p = ptr + 16 * k;
+		if (w(p) != 0x7000)
+			continue;
+		// opcode 7 block: word[0] = count, offset table at base + count words (ends with FFFF),
+		// polygon records at base + offset
+		const uint32_t base = p + 16;
+		const uint32_t cnt = w(base);
+		if (cnt < 2 || cnt > 0x2000)
+			continue;
+		bool ok = false;
+		std::vector<uint16_t> offs;
+		for (uint32_t i = 0, a3 = base + cnt * 16; i < 2048; i++, a3 += 16)
+		{
+			const uint16_t off = w(a3);
+			if (off & 0x8000) { ok = true; break; }
+			if (off == 0 || off >= cnt) break;
+			offs.push_back(off);
+		}
+		if (!ok)
+			continue;
+
+		const uint32_t end = base + cnt * 16;
+		for (uint16_t off : offs)
+		{
+			uint32_t a = base + off * 16;
+			const uint16_t f = w(a); a += 16;
+			if (f & 0x8000)             // bit 15 = skip
+				continue;
+			if (f & 0x1000)
+			{
+				// scaled sprite (GSP FFF48FC0): words x0, y0, x1, ya, -, y1; sprite f & 0x3F -> pointer table FFF78150;
+				// sprite = height, width, 4 more words, then width x height 8-bit pens (pen 0 transparent). The GSP skips
+				// it when the rectangle is off limits (sizes are unlimited with list flag bit 4).
+				const int x0 = int16_t(w(a)), y0 = int16_t(w(a + 16)), x1 = int16_t(w(a + 32)), ya = int16_t(w(a + 48)), y1 = int16_t(w(a + 80));
+				const uint32_t te = 0xfff78150 + 32 * (f & 0x3f);
+				const uint32_t sp = w(te) | (uint32_t(w(te + 16)) << 16);
+				const int dw = x1 - x0 + 1, dh = y1 - ya + 1;
+				const bool big = list->gflags & 0x10;
+				if (!sp || x0 >= 0x200 || y0 >= 0x118 || x1 < 0 || dw <= 0 || (!big && dw >= 0x15e) || y1 < 0x28 || dh <= 0 || (!big && dh >= 0xc8))
+					continue;
+				s60hd_poly poly;
+				poly.flags = f; poly.sprite = 1;
+				poly.dx0 = x0; poly.dy0 = y0; poly.dw = dw; poly.dh = dh;
+				poly.srch = w(sp); poly.srcw = w(sp + 16);
+				if (!poly.srcw || !poly.srch || poly.srcw > 1024 || poly.srch > 1024)
+					continue;
+				poly.hstep = (uint32_t(poly.srcw) << 16) / uint32_t(dw);
+				poly.vstep = (uint32_t(poly.srch) << 16) / uint32_t(dh);
+				const uint32_t n = uint32_t(poly.srcw) * poly.srch;
+				poly.spix.resize(n);
+				const uint32_t px = sp + 0x60;
+				for (uint32_t i = 0; i < n; i += 2)
+				{
+					const uint16_t v = w(px + 8 * i);
+					poly.spix[i] = v & 0xff;
+					if (i + 1 < n) poly.spix[i + 1] = v >> 8;
+				}
+				if (const char *dir = std::getenv("STUN60_HDSPRDUMP"))
+				{
+					// debug: save each sprite image once as a PPM (live palette, pen 0 = magenta)
+					static std::set<uint32_t> done;
+					if (done.insert(sp ^ (uint32_t(f & 0x3f) << 26)).second)
+					{
+						const rgb_t *pens = m_palette->palette()->entry_list_adjusted();
+						char fn[512];
+						std::snprintf(fn, sizeof(fn), "%s/spr_%02X_%08X_%dx%d.ppm", dir, f & 0x3f, sp, poly.srcw, poly.srch);
+						if (FILE *o = std::fopen(fn, "wb"))
+						{
+							std::fprintf(o, "P6\n%d %d\n255\n", poly.srcw, poly.srch);
+							for (uint8_t pen : poly.spix)
+							{
+								const rgb_t c = pen ? pens[m_gfx_palettebank * 256 + pen] : rgb_t(255, 0, 255);
+								const uint8_t b3[3] = { c.r(), c.g(), c.b() };
+								std::fwrite(b3, 1, 3, o);
+							}
+							std::fclose(o);
+						}
+					}
+				}
+				if (std::getenv("STUN60_HDSPRLOG") && (m_hd_lists % 60) == 0)
+					std::fprintf(stderr, "stun60 sprite: list %u flags %04X x %d..%d y %d (%d) h %d  src %dx%d @%08X\n", m_hd_lists, f, x0, x1, y0, ya, dh,
+							poly.srcw, poly.srch, sp);
+				list->polys.push_back(std::move(poly));
+				continue;
+			}
+			s60hd_poly poly;
+			poly.flags = f;
+			poly.pen = w(0xfff71d20 + 16 * (f & 0x3ff)) & 0xff;
+			const int xl = int16_t(w(a)), xr = int16_t(w(a + 16));
+			poly.y0 = w(a + 32);
+			a += 48;
+			if ((f & 0x0c00) == 0x0c00 || (list->gflags & 8))
+			{
+				// the GSP's outline routine (FFF45800): top row, left/right edge lines per segment, bottom row
+				poly.outline = 1;
+				poly.left_only = (list->gflags & 0x20) ? 1 : 0;
+				poly.vy.push_back(0); poly.lxi.push_back(xl); poly.rxi.push_back(xr);
+				poly.lxf.push_back(xl); poly.rxf.push_back(xr);
+			}
+			// edge accumulators: 32.32 fixed point, fraction starts at 0.5 (GSP rounding)
+			int64_t lx = (int64_t(xl) << 32) + 0x80000000LL, rx = (int64_t(xr) << 32) + 0x80000000LL;
+			poly.l.push_back(lx);
+			poly.r.push_back(rx);
+			bool good = false;
+			// records lie below the offset table (end): the end marker needs 2 words, a segment 5
+			for (int seg = 0; seg < 512 && a + 16 < end; seg++)
+			{
+				const uint32_t sr = w(a) | (uint32_t(w(a + 16)) << 16);
+				if (sr == 0xffffffff) { good = true; break; }
+				if (a + 64 >= end) break;
+				const uint32_t sl = w(a + 32) | (uint32_t(w(a + 48)) << 16);
+				const int n = w(a + 64);
+				a += 80;
+				if (n > 512 || poly.l.size() + n > 1024) break;
+				if (poly.outline && n > 1)
+				{
+					// segment end point as the GSP computes it: x += floor(slope * (n - 1)) (16.16, low 32 bits)
+					auto step = [n] (uint32_t sl) { return int32_t(uint32_t(int64_t(int32_t(sl)) * (n - 1))) >> 16; };
+					poly.vy.push_back(poly.vy.back() + n - 1);
+					poly.lxi.push_back(poly.lxi.back() + step(sl));
+					poly.rxi.push_back(poly.rxi.back() + step(sr));
+					poly.lxf.push_back(poly.lxf.back() + double(int32_t(sl)) * (n - 1) / 65536.0);
+					poly.rxf.push_back(poly.rxf.back() + double(int32_t(sr)) * (n - 1) / 65536.0);
+				}
+				for (int j = 0; j < n - 1; j++)
+				{
+					lx += int64_t(int32_t(sl)) << 16;
+					rx += int64_t(int32_t(sr)) << 16;
+					poly.l.push_back(lx);
+					poly.r.push_back(rx);
+				}
+			}
+			if (good)
+				list->polys.push_back(std::move(poly));
+		}
+		break;
+	}
+	// bitmap blits drawn with this list: identify each image by a hash of its pens in GSP RAM (FNV-1a, as the pack)
+	for (s60hd_blit &b : m_hd_blits_cur)
+	{
+		if (b.addr < 0xff800000) continue;
+		const uint32_t len = m_gsp_vram.length();                   // power of two; the RAM is mirrored above it
+		const uint32_t hdr = (b.addr >> 4) & (len - 1);
+		if (hdr + 6 >= len) continue;
+		b.h = m_gsp_vram[hdr]; b.w = m_gsp_vram[hdr + 1];
+		const uint32_t words = (uint32_t(b.w) * b.h + 1) / 2;
+		if (!b.w || !b.h || hdr + 6 + words > len) continue;
+		uint32_t k = 2166136261u;
+		const uint16_t *px = &m_gsp_vram[hdr + 6];
+		for (uint32_t i = 0; i < words; i++)
+		{
+			k = (k ^ (px[i] & 0xff)) * 16777619u;
+			k = (k ^ (px[i] >> 8)) * 16777619u;
+		}
+		b.key = k;
+		list->blits.push_back(b);
+	}
+	m_hd_blits_cur.clear();
+	m_hd_pending = std::move(list);
+}
+
+void harddriv_state::hd_capture_line(screen_device &screen, int scanline, const uint16_t *dest, int x0, int x1)
+{
+	const rectangle &vis = screen.visible_area();
+	const int row = scanline - vis.top();
+	if (row < 0 || row >= 256)
+		return;
+	if (row == 0)
+		m_hd_cur = m_hd_shown;         // the list on screen during this frame
+	uint16_t *out = &m_hd_lowres[row * 512];
+	for (int x = vis.left(), i = 0; x <= vis.right() && i < 512; x++, i++)
+		out[i] = (x >= x0 && x < x1) ? dest[x] : 0;
+	if (scanline == vis.bottom())
+	{
+		// the previous HD frame must be finished first: it reads m_hd_done, the list, the palette copy and m_hd_bgs
+		hd_worker_wait();
+		hd_take_built();
+		m_hd_done.swap(m_hd_lowres);
+		m_hd_done_list = m_hd_cur;
+		m_hd_w = std::min(vis.width(), 512);
+		m_hd_h = std::min(vis.height(), 256);
+		m_hd_frames++;
+		if (m_hd_always || machine().render().is_live(*m_hdscreen))
+		{
+			const rgb_t *pens = m_palette->palette()->entry_list_adjusted();   // colours (pens() would give indices)
+			m_hd_pal.assign(pens, pens + m_palette->entries());
+			m_hd_bank = m_gfx_palettebank;
+			m_hd_2d = machine().output().get_value("stun60_hd2d_off") == 0;
+			if (m_hd_sync)
+			{
+				// compose now, so the HD screen shows this frame (its own refresh comes slightly earlier)
+				hd_compose(*m_hd_work);
+				std::swap(m_hd_disp, m_hd_work);
+			}
+			else
+			{
+				// compose in the worker while the next frame is emulated; shown from the next frame on
+				if (!m_hd_worker.joinable())
+					m_hd_worker = std::thread([this] () { hd_worker_loop(); });
+				std::lock_guard<std::mutex> g(m_hd_wlock);
+				m_hd_wjob = true;
+				m_hd_wcv.notify_all();
+			}
+		}
+	}
+}
+
+void harddriv_state::hd_worker_loop()
+{
+	std::unique_lock<std::mutex> g(m_hd_wlock);
+	for (;;)
+	{
+		m_hd_wcv.wait(g, [this] () { return m_hd_wjob || m_hd_wquit; });
+		if (m_hd_wquit)
+			return;
+		g.unlock();
+		hd_compose(*m_hd_work);
+		g.lock();
+		m_hd_wjob = false;
+		m_hd_wdone = true;
+		m_hd_wcv.notify_all();
+	}
+}
+
+// wait until the worker has finished its frame, then show it
+void harddriv_state::hd_worker_wait()
+{
+	if (!m_hd_worker.joinable())
+		return;
+	std::unique_lock<std::mutex> g(m_hd_wlock);
+	m_hd_wcv.wait(g, [this] () { return !m_hd_wjob; });
+	if (m_hd_wdone)
+	{
+		m_hd_wdone = false;
+		std::swap(m_hd_disp, m_hd_work);
+	}
+}
+
+void harddriv_state::hd_stop()
+{
+	if (!m_hd_worker.joinable())
+		return;
+	{
+		std::lock_guard<std::mutex> g(m_hd_wlock);
+		m_hd_wquit = true;
+		m_hd_wcv.notify_all();
+	}
+	m_hd_worker.join();
+}
+
+uint32_t harddriv_state::hd_screen_update(screen_device &screen, bitmap_rgb32 &bitmap, const rectangle &cliprect)
+{
+	copybitmap(bitmap, *m_hd_disp, 0, 0, 0, 0, cliprect);
+	return 0;
+}
+
+void harddriv_state::hd_compose(bitmap_rgb32 &bitmap)
+{
+	static double t_sum[3]; static int t_n;
+	const bool dbg = std::getenv("STUN60_HDDEBUG") != nullptr;
+	auto t0 = std::chrono::steady_clock::now();
+	const int SX = m_hd_sx, SY = m_hd_sy;
+	const int W = std::min(m_hd_w, bitmap.width() / SX), H = std::min(m_hd_h, bitmap.height() / SY);
+	const int PLAY = std::min(208, H);          // 3D playfield rows (the HUD is below)
+	const int bank = m_hd_bank * 256;
+	const s60hd_list *list = m_hd_done_list.get();
+	auto shadow_on = [] (int x, int y) { return (x & 3) == ((y & 1) ? 2 : 0); };
+	// fill pattern (GSP FFF45150): mode 2 = 1 pixel in 4 (01010101, the shadow), mode 1 or colour index 4 = 3 pixels
+	// in 4 (15151515, the see-through dissolve), both shifted by 2 pixels on odd rows; else solid
+	auto pattern = [] (uint16_t f) { const int m = (f >> 10) & 3; return (m == 1 || (f & 0xff) == 4) ? 1 : m == 2 ? 2 : 0; };
+	auto dissolve_on = [] (int x, int y) { return (x & 3) != ((y & 1) ? 1 : 3); };
+
+	// 1. expected pen per low-res pixel: the polygons rasterized exactly like the GSP does
+	m_hd_exp.assign(W * H, -1);
+	m_hd_wpen.assign(W * H, 0);
+	m_hd_wcnt.assign(W * H, 0);
+	// wireframe lines: mark the low-res pixels the GSP's line may have set (within 1 pixel of the line, the game's
+	// own integer end points), so a pixel showing the line's pen there counts as part of the 3D scene
+	auto wmark = [&] (int x0, int y0, int x1, int y1, int pen)
+	{
+		const int dx = x1 - x0, dy = y1 - y0, n = std::max(std::abs(dx), std::abs(dy));
+		for (int i = 0; i <= n; i++)
+		{
+			const double t = n ? double(i) / n : 0.0;
+			const int cx = int(std::lround(x0 + dx * t)), cy = int(std::lround(y0 + dy * t)) - 0x28;
+			for (int oy = -1; oy <= 1; oy++)
+				for (int ox = -1; ox <= 1; ox++)
+				{
+					const int x = cx + ox, r = cy + oy;
+					if (x >= 0 && x < W && r >= 0 && r < PLAY)
+					{
+						const int i = r * W + x;
+						uint32_t &v = m_hd_wpen[i]; uint8_t &c = m_hd_wcnt[i];
+						bool have = false;
+						for (int k = 0; k < c; k++) if (((v >> (8 * k)) & 0xff) == uint32_t(pen)) have = true;
+						if (have) continue;
+						if (c < 4) { v |= uint32_t(pen) << (8 * c); c++; }
+						else v = (v << 8) | pen;                 // keep the 4 latest
+					}
+				}
+		}
+	};
+	if (list)
+		for (const s60hd_poly &p : list->polys)
+		{
+			if (p.sprite)
+			{
+				// GSP stepping: source column of pixel k = k * int + floor((k + 1) * frac), rows the same way
+				for (int j = 0; j < p.dh; j++)
+				{
+					const int r = p.dy0 + j - 0x28;
+					if (r < 0 || r >= PLAY) continue;
+					const uint32_t sy = j * (p.vstep >> 16) + (((j + 1) * uint64_t(p.vstep & 0xffff)) >> 16);
+					const uint8_t *src = &p.spix[std::min<uint32_t>(sy, p.srch - 1) * p.srcw];
+					for (int k = 0; k < p.dw; k++)
+					{
+						const int x = p.dx0 + k;
+						if (x < 0 || x >= W) continue;
+						const uint32_t sx = k * (p.hstep >> 16) + (((k + 1) * uint64_t(p.hstep & 0xffff)) >> 16);
+						const uint8_t pen = src[std::min<uint32_t>(sx, p.srcw - 1)];
+						if (!pen) continue;
+						m_hd_exp[r * W + x] = pen;
+						m_hd_wpen[r * W + x] = 0; m_hd_wcnt[r * W + x] = 0;
+					}
+				}
+				continue;
+			}
+			if (p.outline)
+			{
+				const size_t k = p.vy.size() - 1;
+				wmark(p.lxi[0], p.y0, p.rxi[0], p.y0, p.pen);
+				wmark(p.lxi[k], p.y0 + p.vy[k], p.rxi[k], p.y0 + p.vy[k], p.pen);
+				for (size_t j = 0; j < k; j++)
+				{
+					wmark(p.lxi[j], p.y0 + p.vy[j], p.lxi[j + 1], p.y0 + p.vy[j + 1], p.pen);
+					if (!p.left_only)
+						wmark(p.rxi[j], p.y0 + p.vy[j], p.rxi[j + 1], p.y0 + p.vy[j + 1], p.pen);
+				}
+				continue;
+			}
+			const int pat = pattern(p.flags);
+			for (size_t i = 0; i < p.l.size(); i++)
+			{
+				const int y = p.y0 + int(i), r = y - 0x28;
+				if (r < 0 || r >= PLAY) continue;
+				const int a = std::max<int64_t>(p.l[i] >> 32, 0), b = std::min<int64_t>(p.r[i] >> 32, W - 1);
+				for (int x = a; x <= b; x++)
+					if (pat == 0 || (pat == 2 ? shadow_on(x, y) : dissolve_on(x, y)))
+					{
+						m_hd_exp[r * W + x] = p.pen;
+						m_hd_wpen[r * W + x] = 0; m_hd_wcnt[r * W + x] = 0;    // a later polygon covers the lines here
+					}
+			}
+		}
+
+	// 2. classify, then fill the HD bitmap with the low-res image scaled up
+	const rgb_t *pens = m_hd_pal.data();             // palette copy taken when the frame completed
+	const int npens = int(m_hd_pal.size());
+	auto pc = [pens, npens] (int v) -> uint32_t { return uint32_t(pens[v < npens ? v : 0]) | 0xff000000; };
+	m_hd_cls.assign(W * H, 0);
+	for (int r = 0; r < H; r++)
+	{
+		const uint16_t *src = &m_hd_done[r * 512];
+		uint8_t *cls = &m_hd_cls[r * W];
+		const int16_t *exp = &m_hd_exp[r * W];
+		const uint32_t *wp = &m_hd_wpen[r * W];
+		const uint8_t *wc = &m_hd_wcnt[r * W];
+		for (int x = 0; x < W; x++)
+		{
+			const uint32_t v = src[x] & 0xff;
+			bool wire = false;
+			for (int k = 0; k < wc[x]; k++) if (((wp[x] >> (8 * k)) & 0xff) == v) wire = true;
+			if (exp[x] >= 0 && int(v) == exp[x]) cls[x] = 1;
+			else if (wire) cls[x] = 3;
+			else if (exp[x] >= 0) cls[x] = 2;
+		}
+		uint32_t *d0 = &bitmap.pix(r * SY);
+		for (int x = 0; x < W; x++)
+		{
+			uint32_t c = pc(src[x]);
+			if (cls[x] == 1 || cls[x] == 3)
+			{
+				// under a 3D pixel the background is unknown: borrow the nearest non-3D pixel in this row
+				// (only visible where an HD polygon edge leaves part of the low-res pixel uncovered)
+				c = 0xff000000;
+				for (int d = 1; d <= 8; d++)
+				{
+					if (x - d >= 0 && cls[x - d] == 0) { c = pc(src[x - d]); break; }
+					if (x + d < W && cls[x + d] == 0) { c = pc(src[x + d]); break; }
+				}
+			}
+			uint32_t *d = d0 + x * SX;
+			for (int xx = 0; xx < SX; xx++)
+				d[xx] = c;
+		}
+		for (int yy = 1; yy < SY; yy++)
+			std::memcpy(&bitmap.pix(r * SY + yy), d0, W * SX * sizeof(uint32_t));
+	}
+
+	// the palette variant of an HD image closest to the colours on screen now
+	auto pick = [&] (const std::vector<s60hd_bg> &vs, int w, int h) -> const s60hd_bg * {
+		const s60hd_bg *best = nullptr; int bestd = 0;
+		for (const s60hd_bg &v : vs)
+		{
+			if (v.w != w || v.h != h) continue;
+			int d = 0;
+			for (uint8_t p : v.used)
+			{
+				const int pv = bank + p;
+				const rgb_t c = pens[pv < npens ? pv : 0];
+				d += std::abs(c.r() - v.ref[p][0]) + std::abs(c.g() - v.ref[p][1]) + std::abs(c.b() - v.ref[p][2]);
+			}
+			if (!best || d < bestd) { best = &v; bestd = d; }
+		}
+		return best;
+	};
+
+	// 2a. whole-screen images (title, course map, HUD panel...): the game copies them straight into the frame buffer,
+	// so there is no blit to follow. Sample the frame: the best image per screen area (row 0 / the HUD at row 208) whose
+	// pens match at least 60% of the samples is drawn (where the pens match, so text drawn on top stays).
+	m_hd_fs_drawn = 0;
+	std::vector<std::pair<s60hd_blit, const s60hd_bg *>> draws;
+	for (int area = 0; area < (m_hd_2d ? 2 : 0); area++)
+	{
+		const s60hd_bg *best = nullptr; int bestm = 0, bestrow = 0;
+		for (uint32_t key : m_hd_fskeys)
+		{
+			auto it = m_hd_bgs.find(key);
+			if (it == m_hd_bgs.end() || it->second.empty()) continue;
+			const s60hd_bg &v0 = it->second.front();
+			const int row = v0.h == 32 ? 208 : 0;
+			if ((row != 0) != (area == 1) || row + v0.h > H) continue;
+			const int IW = v0.w * SX;
+			int m = 0, t = 0;
+			for (int r = 1; r < v0.h; r += 3)
+			{
+				const uint16_t *src = &m_hd_done[(row + r) * 512];
+				const uint8_t *prow = &v0.pen[size_t(r) * SY * IW];
+				for (int x = 2; x < W; x += 5, t++)
+					m += (src[x] & 0xff) == prow[x * SX];
+			}
+			if (t && m * 10 >= t * 6 && m * 1000 / t > bestm)
+			{
+				const s60hd_bg *v = pick(it->second, v0.w, v0.h);
+				if (v) { best = v; bestm = m * 1000 / t; bestrow = row; }
+			}
+		}
+		if (best)
+		{
+			s60hd_blit b = {};
+			b.x = 0; b.y = int16_t(0x28 + bestrow); b.w = best->w; b.h = best->h;
+			draws.emplace_back(b, best);
+			m_hd_fs_drawn |= 1u << area;
+		}
+	}
+
+	// 2b. backgrounds from the HD pack, where the low-res frame really shows them
+	if (list)
+		for (const s60hd_blit &b : list->blits)
+		{
+			auto it = m_hd_bgs.find(b.key);
+			if (it == m_hd_bgs.end()) continue;
+			if (const s60hd_bg *best = pick(it->second, b.w, b.h))
+				draws.emplace_back(b, best);
+		}
+	m_hd_img.assign(W * H, 0);
+	for (const auto &d : draws)
+		hd_mark_bg(d.first, *d.second, W, H);
+
+	// 2x. xBR for the 2D the game draws live (text, HUD numbers, the course map's track line, the speed bars): every
+	// non-3D low-res pixel with a differing neighbour gets the xBR edge decisions for its 4 corners (Hyllian's rules,
+	// as in the 4x filter: weighted colour distances over the 5x5 neighbourhood, 45 degree / shallow / steep lines), and
+	// each HD pixel takes the neighbour's colour by its coverage of the decided edge line (analytic, anti-aliased), so it
+	// works at any SX x SY. 3D neighbours count as the pixel's own colour (polygon edges are redrawn in HD anyway).
+	// HD pixels that took a neighbour's colour are marked in m_hd_xm so the HD images below don't paint over them.
+	m_hd_xm.assign(size_t(W) * SX * H * SY, 0);
+	m_hd_xcells = 0;
+	if (m_hd_xbr && m_hd_2d)
+	{
+		m_hd_lc.resize(W * H);
+		for (int r = 0; r < H; r++)
+			for (int x = 0; x < W; x++)
+				m_hd_lc[r * W + x] = pc(m_hd_done[r * 512 + x]) & 0xffffff;
+		// mark both pixels of every differing neighbour pair (right, down, both diagonals); 3D pixels never differ
+		m_hd_nf.assign(W * H, 0);
+		{
+			const uint32_t *lc = m_hd_lc.data(); const uint8_t *cl = m_hd_cls.data(); uint8_t *nf = m_hd_nf.data();
+			const uint8_t *im = m_hd_img.data();
+			auto is3d = [cl] (int i) { return cl[i] == 1 || cl[i] == 3; };
+			for (int r = 0; r < H; r++)
+				for (int x = 0; x < W; x++)
+				{
+					const int i = r * W + x;
+					if (is3d(i)) continue;
+					// two HD-image pixels never count as different (the image's own detail is upscaled already)
+					auto pair = [&] (int j) { if (!is3d(j) && lc[j] != lc[i] && !(im[i] && im[j])) { nf[i] = 1; nf[j] = 1; } };
+					if (x + 1 < W) pair(i + 1);
+					if (r + 1 < H)
+					{
+						pair(i + W);
+						if (x + 1 < W) pair(i + W + 1);
+						if (x > 0) pair(i + W - 1);
+					}
+				}
+		}
+		auto yuv = [] (uint32_t c, int &y, int &u, int &v) {
+			const int R = (c >> 16) & 0xff, G = (c >> 8) & 0xff, B = c & 0xff;
+			y = (299 * R + 587 * G + 114 * B) / 1000; u = B - y; v = R - y;
+		};
+		auto df = [&] (uint32_t a, uint32_t b) -> int {
+			if (a == b) return 0;
+			int ya, ua, va, yb, ub, vb; yuv(a, ya, ua, va); yuv(b, yb, ub, vb);
+			return 48 * std::abs(ya - yb) + 7 * std::abs(ua - ub) + 6 * std::abs(va - vb);
+		};
+		const int HW = W * SX;
+		for (int r = 0; r < H; r++)
+			for (int x = 0; x < W; x++)
+			{
+				if (!m_hd_nf[r * W + x]) continue;
+				const uint32_t E = m_hd_lc[r * W + x];
+				const bool eimg = m_hd_img[r * W + x];
+				// neighbour colour; outside the screen, 3D, or (seen from an HD-image pixel) another HD-image pixel = E
+				auto g = [&] (int dx, int dy) -> uint32_t {
+					const int xx = x + dx, rr = r + dy;
+					if (xx < 0 || xx >= W || rr < 0 || rr >= H) return E;
+					const int k = rr * W + xx, c = m_hd_cls[k];
+					return (c == 1 || c == 3 || (eimg && m_hd_img[k])) ? E : m_hd_lc[k];
+				};
+				// per corner (mirror mx, my: +1 = right/down): edge line a*u + b*v > c in corner-local coordinates
+				// (u, v in [0,1], 0 = the pixel's far side), colour px; a = 0 means no edge at this corner
+				struct { float a, b, c, s; uint32_t px; } cn[4];
+				int ncn = 0;
+				for (int k = 0; k < 4; k++)
+				{
+					const int mx = (k & 1) ? -1 : 1, my = (k & 2) ? -1 : 1;
+					auto n = [&] (int dx, int dy) { return g(dx * mx, dy * my); };
+					const uint32_t A = n(-1, -1), B = n(0, -1), C = n(1, -1), D = n(-1, 0), F = n(1, 0), G = n(-1, 1), H_ = n(0, 1), I = n(1, 1);
+					const uint32_t C4 = n(2, -1), F4 = n(2, 0), I4 = n(2, 1), G5 = n(-1, 2), H5 = n(0, 2), I5 = n(1, 2);
+					(void)A; (void)C4; (void)G5;
+					if (E == H_ || E == F) continue;
+					const int e = df(E, C) + df(E, G) + df(I, H5) + df(I, F4) + 4 * df(H_, F);
+					const int i = df(H_, D) + df(H_, I5) + df(F, I4) + df(F, B) + 4 * df(E, I);
+					if (e >= i) continue;
+					const uint32_t px = df(E, F) <= df(E, H_) ? F : H_;
+					const bool strong = (F != B && F != C) || (H_ != D && H_ != G) || (E == I && ((F != F4 && F != I4) || (H_ != H5 && H_ != I5))) || E == G || E == C;
+					float a = 1, b = 1, c = 1.5f, st = 1.0f;
+					if (strong)
+					{
+						const int ke = df(F, G), ki = df(H_, C);
+						const bool left = 2 * ke <= ki && E != G && D != G;    // shallow edge (runs on towards G)
+						const bool up = ke >= 2 * ki && E != C && B != C;      // steep edge (runs on towards C)
+						if (left && up) { a = 1; b = 1; c = 1.0f; }
+						else if (left) { a = 0.5f; b = 1; c = 1.0f; }
+						else if (up) { a = 1; b = 0.5f; c = 1.0f; }
+					}
+					else st = 0.5f;      // weak edge: half blend of the corner only
+					// store in screen orientation: u = (mx > 0 ? fx : 1 - fx)
+					cn[ncn].a = a * mx; cn[ncn].b = b * my; cn[ncn].c = c - (mx < 0 ? a : 0) - (my < 0 ? b : 0); cn[ncn].s = st; cn[ncn].px = px;
+					ncn++;
+				}
+				if (!ncn) continue;
+				m_hd_xcells++;
+				for (int yy = 0; yy < SY; yy++)
+				{
+					const float fy = (yy + 0.5f) / SY;
+					uint32_t *d = &bitmap.pix(r * SY + yy) + x * SX;
+					uint8_t *xm = &m_hd_xm[size_t(r * SY + yy) * HW + x * SX];
+					for (int xx = 0; xx < SX; xx++)
+					{
+						const float fx = (xx + 0.5f) / SX;
+						float cr = float((E >> 16) & 0xff), cg = float((E >> 8) & 0xff), cb = float(E & 0xff);
+						bool took = false;
+						for (int k = 0; k < ncn; k++)
+						{
+							const float s = cn[k].a * fx + cn[k].b * fy - cn[k].c;
+							const float fw = 0.5f * (std::fabs(cn[k].a) / SX + std::fabs(cn[k].b) / SY);
+							const float cov = std::clamp((s + fw) / (2 * fw), 0.0f, 1.0f) * cn[k].s;
+							if (cov <= 0) continue;
+							const uint32_t p = cn[k].px;
+							cr += (float((p >> 16) & 0xff) - cr) * cov; cg += (float((p >> 8) & 0xff) - cg) * cov; cb += (float(p & 0xff) - cb) * cov;
+							took = true;
+						}
+						if (!took) continue;
+						d[xx] = 0xff000000 | (uint32_t(cr + 0.5f) << 16) | (uint32_t(cg + 0.5f) << 8) | uint32_t(cb + 0.5f);
+						xm[xx] = 1;
+					}
+				}
+			}
+	}
+
+	for (const auto &d : draws)
+		hd_draw_bg(bitmap, d.first, *d.second, W, H);
+
+	auto t1 = std::chrono::steady_clock::now();
+	if (std::getenv("STUN60_HDDEBUG") && (m_hd_frames % 300) == 0)
+	{
+		int c[4] = { 0, 0, 0, 0 };
+		for (int i = 0; i < W * PLAY; i++) c[m_hd_cls[i]]++;
+		std::fprintf(stderr, "stun60 HD: frame %u lists %u polys %d playfield px: bg %d 3d %d over %d wire %d; blits %d, HD bg px %u, full-screen %u, xBR cells %u\n",
+				m_hd_frames, m_hd_lists, list ? int(list->polys.size()) : -1, c[0], c[1], c[2], c[3],
+				list ? int(list->blits.size()) : -1, m_hd_bg_drawn, m_hd_fs_drawn, m_hd_xcells);
+		if (list)
+			for (const s60hd_blit &b : list->blits)
+				std::fprintf(stderr, "   blit x %d y %d fl %04X addr %08X %dx%d key %08X %s\n", b.x, b.y, b.flags, b.addr, b.w, b.h, b.key,
+						m_hd_bgs.count(b.key) ? "HD" : "-");
+	}
+
+	// 3. the polygons at full resolution, in list order (later ones on top).
+	// Anti-aliasing (m_hd_aa = A > 1) is supersampling restricted to edge pixels: while drawing, every HD pixel a polygon
+	// edge may cross (judged from the spans at A sub-rows) is marked; afterwards those pixels alone are drawn again from
+	// the picture as it was before this pass at A x A samples, with the same rules and in the same order, and take the
+	// average. All other pixels are covered or not by each polygon in full, so this equals full supersampling, and edges
+	// shared by two polygons stay seamless.
+	// Rows are independent, so the playfield is split into bands drawn by m_hd_threads threads.
+	if (list)
+	{
+		const int HW = W * SX, HP = PLAY * SY;
+		const int A = std::max(m_hd_aa, 1), AA = A * A, SXA = SX * A;
+		const bool aa = A > 1;
+		if (aa)
+		{
+			m_hd_pre.resize(size_t(HW) * HP);
+			if (m_hd_eidx.size() != size_t(HW) * HP) m_hd_eidx.assign(size_t(HW) * HP, -1);
+		}
+		// rows with no "drawn over" pixel take a plain span fill (almost all of them)
+		std::vector<uint8_t> row_over(PLAY, 0);
+		for (int r = 0; r < PLAY; r++)
+			for (int x = 0; x < W; x++)
+				if (m_hd_cls[r * W + x] == 2) { row_over[r] = 1; break; }
+		// span of polygon p at vertical position u (in list lines from p.y0), in units of 1 / sx low-res pixels:
+		// lines are sampled at row centres, interpolate between them
+		auto span = [] (const s60hd_poly &p, double u, int sx, int maxx, int &X0, int &X1) -> bool
+		{
+			const int n = int(p.l.size());
+			double L, R;
+			if (n == 1) { L = double(p.l[0]); R = double(p.r[0]); }
+			else
+			{
+				int i = int(std::floor(u));
+				i = std::clamp(i, 0, n - 2);
+				const double f = u - i;
+				L = p.l[i] + (double(p.l[i + 1]) - double(p.l[i])) * f;
+				R = p.r[i] + (double(p.r[i + 1]) - double(p.r[i])) * f;
+				// in the half line beyond the first/last line the span may only narrow (sharper
+				// apexes), never widen (near-horizontal edges would grow long needles)
+				if (u < 0) { L = std::max(L, double(p.l[0])); R = std::min(R, double(p.r[0])); }
+				else if (u > n - 1) { L = std::max(L, double(p.l[n - 1])); R = std::min(R, double(p.r[n - 1])); }
+			}
+			const double xl = L * (1.0 / 4294967296.0) - 0.5, xr1 = R * (1.0 / 4294967296.0) + 0.5;
+			X0 = std::max(int(std::ceil(xl * sx - 0.5)), 0);                  // centre in [xl, xr1)
+			X1 = std::min(int(std::ceil(xr1 * sx - 0.5)) - 1, maxx);
+			return X1 >= X0;
+		};
+		// one sample / pixel of a filled polygon
+		auto shade = [] (uint32_t &d, int pat, uint32_t col)
+		{
+			if (pat == 2)
+			{
+				const rgb_t o(d);
+				d = rgb_t(0xff, o.r() * 7 / 10, o.g() * 7 / 10, o.b() * 7 / 10);
+			}
+			else if (pat == 1)
+			{
+				// 3 pixels in 4: the colour at 75% over what is behind it
+				const rgb_t o(d), c(col);
+				d = rgb_t(0xff, (o.r() + 3 * c.r()) / 4, (o.g() + 3 * c.g()) / 4, (o.b() + 3 * c.b()) / 4);
+			}
+			else
+				d = col;
+		};
+
+		const int nb = std::clamp(m_hd_threads, 1, 16);
+		if (int(m_hd_band.size()) < nb) m_hd_band.resize(nb);
+		// one band of HD rows [yb0, yb1)
+		auto band = [&] (s60hd_band &bs, int yb0, int yb1)
+		{
+			std::vector<uint32_t> &elist = bs.elist;
+			std::vector<int32_t> &sub = bs.sub;
+			elist.clear(); sub.clear();
+			if (aa)
+				for (int y = yb0; y < yb1; y++) std::memcpy(&m_hd_pre[size_t(y) * HW], &bitmap.pix(y), HW * sizeof(uint32_t));
+			auto mark = [&] (int y, int xa, int xb)
+			{
+				xa = std::max(xa, 0); xb = std::min(xb, HW - 1);
+				int32_t *e = &m_hd_eidx[size_t(y) * HW];
+				for (int x = xa; x <= xb; x++)
+					if (e[x] < 0) { e[x] = 0; elist.push_back(uint32_t(y) * HW + x); }
+			};
+			// anti-aliased line (m_hd_linew HD pixels wide, round ends) between low-res pixel centres; s = samples per
+			// HD pixel (1: into the picture; A: into the samples of edge pixels only)
+			auto hline = [&] (double ax, double ay, double bx, double by, uint32_t col, int s)
+			{
+				const double hw = m_hd_linew * 0.5 * s;
+				const int SXs = SX * s, SYs = SY * s, TW = HW * s;
+				ax = (ax + 0.5) * SXs; bx = (bx + 0.5) * SXs;
+				ay = (ay - 0x28 + 0.5) * SYs; by = (by - 0x28 + 0.5) * SYs;
+				const double dx = bx - ax, dy = by - ay, l2 = dx * dx + dy * dy;
+				const int Y0 = std::max(int(std::floor(std::min(ay, by) - hw - 1)), yb0 * s);
+				const int Y1 = std::min(int(std::ceil(std::max(ay, by) + hw + 1)), yb1 * s - 1);
+				if (Y1 < Y0) return;
+				const bool steep = std::abs(dy) >= std::abs(dx);
+				const int cr = (col >> 16) & 0xff, cg = (col >> 8) & 0xff, cb = col & 0xff;
+				auto plot = [&] (int X, int Y)
+				{
+					if (X < 0 || X >= TW || Y < Y0 || Y > Y1) return;
+					if (m_hd_cls[(Y / SYs) * W + X / SXs] == 2) return;     // something was drawn over the 3D scene here
+					uint32_t *dp;
+					if (s == 1) dp = &bitmap.pix(Y, X);
+					else
+					{
+						const int32_t e = m_hd_eidx[size_t(Y / s) * HW + X / s];
+						if (e < 0) return;
+						dp = &bs.ss[size_t(e) * AA + (Y % s) * s + X % s];
+					}
+					const double px = X + 0.5 - ax, py = Y + 0.5 - ay;
+					double t = l2 > 0 ? (px * dx + py * dy) / l2 : 0.0;
+					t = std::clamp(t, 0.0, 1.0);
+					const double ex = px - t * dx, ey = py - t * dy;
+					const double cov = std::clamp(hw + 0.5 - std::sqrt(ex * ex + ey * ey), 0.0, 1.0);
+					if (cov <= 0) return;
+					uint32_t &d = *dp;
+					const int a = int(cov * 256);
+					const int r = ((d >> 16) & 0xff), g = ((d >> 8) & 0xff), b = d & 0xff;
+					d = 0xff000000 | ((r + (((cr - r) * a) >> 8)) << 16) | ((g + (((cg - g) * a) >> 8)) << 8) | (b + (((cb - b) * a) >> 8));
+				};
+				const int ext = int(std::ceil(hw + 1));
+				if (steep)
+				{
+					for (int Y = Y0; Y <= Y1; Y++)
+					{
+						const double t = std::clamp((Y + 0.5 - ay) / dy, 0.0, 1.0);
+						const int xc = int(std::floor(ax + t * dx));
+						for (int X = xc - ext; X <= xc + ext; X++) plot(X, Y);
+					}
+				}
+				else
+				{
+					const int X0 = std::max(int(std::floor(std::min(ax, bx) - hw - 1)), 0);
+					const int X1 = std::min(int(std::ceil(std::max(ax, bx) + hw + 1)), TW - 1);
+					for (int X = X0; X <= X1; X++)
+					{
+						const double t = std::clamp((X + 0.5 - ax) / dx, 0.0, 1.0);
+						const int yc = int(std::floor(ay + t * dy));
+						for (int Y = yc - ext; Y <= yc + ext; Y++) plot(X, Y);
+					}
+				}
+			};
+			auto outline = [&] (const s60hd_poly &p, int s)
+			{
+				const uint32_t col = pc(bank + p.pen);
+				const size_t k = p.vy.size() - 1;
+				hline(p.lxf[0], p.y0, p.rxf[0], p.y0, col, s);
+				for (size_t j = 0; j < k; j++)
+				{
+					hline(p.lxf[j], p.y0 + p.vy[j], p.lxf[j + 1], p.y0 + p.vy[j + 1], col, s);
+					if (!p.left_only)
+						hline(p.rxf[j], p.y0 + p.vy[j], p.rxf[j + 1], p.y0 + p.vy[j + 1], col, s);
+				}
+				if (k)
+					hline(p.lxf[k], p.y0 + p.vy[k], p.rxf[k], p.y0 + p.vy[k], col, s);
+			};
+			// sprite pen at a position inside its rectangle (u, v in low-res pixels from its top left corner):
+			// source = u * step. The GSP gives pixel k the source column k * step + frac(step), which always lies in
+			// [k * step, (k + 1) * step], so this is the same picture without the GSP's rounding (finer when shrunk)
+			auto spen = [] (const s60hd_poly &p, double u, double v) -> uint8_t
+			{
+				const int sx = std::clamp(int(std::floor(u * (p.hstep / 65536.0))), 0, p.srcw - 1);
+				const int sy = std::clamp(int(std::floor(v * (p.vstep / 65536.0))), 0, p.srch - 1);
+				return p.spix[sy * p.srcw + sx];
+			};
+			// HD rows / columns of sprite p inside this band
+			auto srect = [&] (const s60hd_poly &p, int &Ya, int &Yb, int &Xa, int &Xb)
+			{
+				Ya = std::max(std::max(p.dy0 - 0x28, 0) * SY, yb0);
+				Yb = std::min(std::min(p.dy0 - 0x28 + p.dh, PLAY) * SY, yb1);
+				Xa = std::max(p.dx0, 0) * SX;
+				Xb = std::min(p.dx0 + p.dw, W) * SX - 1;
+			};
+			// HD rows of polygon p inside this band
+			auto rows = [&] (const s60hd_poly &p, int &Ya, int &Yb)
+			{
+				const int n = int(p.l.size());
+				const int r0 = std::max(p.y0 - 0x28, 0), r1 = std::min(p.y0 + n - 1 - 0x28, PLAY - 1);
+				Ya = std::max(r0 * SY, yb0); Yb = std::min((r1 + 1) * SY, yb1);
+			};
+
+			// pass 1: every pixel at its centre; mark the edge pixels (and keep the sub-row spans for pass 2)
+			for (const s60hd_poly &p : list->polys)
+			{
+				if (p.outline) { outline(p, 1); continue; }
+				if (p.sprite)
+				{
+					int Ya, Yb, Xa, Xb; srect(p, Ya, Yb, Xa, Xb);
+					for (int Y = Ya; Y < Yb; Y++)
+					{
+						if (aa) mark(Y, Xa, Xb);           // the whole rectangle (transparent pixels give the outline)
+						const double v = (Y + 0.5) / SY - (p.dy0 - 0x28);
+						const uint8_t *cls = &m_hd_cls[(Y / SY) * W];
+						uint32_t *d = &bitmap.pix(Y);
+						for (int X = Xa; X <= Xb; X++)
+						{
+							if (cls[X / SX] == 2) continue;
+							const uint8_t pen = spen(p, (X + 0.5) / SX - p.dx0, v);
+							if (pen) d[X] = pc(bank + pen);
+						}
+					}
+					continue;
+				}
+				const int pat = pattern(p.flags);
+				const uint32_t col = pc(bank + p.pen);
+				int Ya, Yb; rows(p, Ya, Yb);
+				for (int Y = Ya; Y < Yb; Y++)
+				{
+					const int r = Y / SY;
+					int X0, X1;
+					const bool any = span(p, (Y + 0.5) / SY + 0x28 - 0.5 - p.y0, SX, HW - 1, X0, X1);
+					if (aa)
+					{
+						// edge pixels: between the lowest and highest left (and right) end over the sub-rows
+						int l0 = INT_MAX, l1 = INT_MIN, h0 = INT_MAX, h1 = INT_MIN; bool empty = false;
+						if (any) { l0 = l1 = X0; h0 = h1 = X1; }
+						for (int k = 0; k < A; k++)
+						{
+							int a0, a1;
+							const bool ok = span(p, (Y + (k + 0.5) / A) / SY + 0x28 - 0.5 - p.y0, SXA, HW * A - 1, a0, a1);
+							sub.push_back(ok ? a0 : 1); sub.push_back(ok ? a1 : 0);
+							if (ok)
+							{
+								l0 = std::min(l0, a0 / A); l1 = std::max(l1, a0 / A);
+								h0 = std::min(h0, a1 / A); h1 = std::max(h1, a1 / A);
+							}
+							else empty = true;
+						}
+						if (l0 != INT_MAX)
+						{
+							if (empty || !any) mark(Y, l0, h1);
+							else { mark(Y, l0, l1); mark(Y, h0, h1); }
+						}
+					}
+					if (!any) continue;
+					uint32_t *d = &bitmap.pix(Y);
+					if (pat == 0 && !row_over[r]) { std::fill(d + X0, d + X1 + 1, col); continue; }
+					const uint8_t *cls = &m_hd_cls[r * W];
+					for (int X = X0; X <= X1; X++)
+						if (cls[X / SX] != 2)       // else something was drawn over the 3D scene here
+							shade(d[X], pat, col);
+				}
+			}
+			if (!aa) return;
+			if (elist.empty()) return;
+
+			// pass 2: the edge pixels again at A x A samples, then their average
+			// order by row (counting sort), then by x inside each row (a few dozen per row)
+			const size_t ne = elist.size();
+			const int nr = yb1 - yb0;
+			std::vector<uint32_t> &rowstart = bs.rowstart;
+			rowstart.assign(nr + 1, 0);
+			for (uint32_t e : elist) rowstart[e / HW - yb0 + 1]++;
+			for (int y = 0; y < nr; y++) rowstart[y + 1] += rowstart[y];
+			bs.esort.resize(ne);
+			{
+				std::vector<uint32_t> fillp(rowstart.begin(), rowstart.end() - 1);
+				for (uint32_t e : elist) bs.esort[fillp[e / HW - yb0]++] = e;
+			}
+			elist.swap(bs.esort);
+			for (int y = 0; y < nr; y++)
+				if (rowstart[y + 1] - rowstart[y] > 1) std::sort(&elist[rowstart[y]], &elist[0] + rowstart[y + 1]);
+			for (size_t i = 0; i < ne; i++) m_hd_eidx[elist[i]] = int32_t(i);
+			bs.ss.resize(ne * AA);
+			for (size_t i = 0; i < ne; i++) std::fill_n(&bs.ss[i * AA], AA, m_hd_pre[elist[i]]);
+			const int32_t *sp = sub.data();
+			for (const s60hd_poly &p : list->polys)
+			{
+				if (p.outline) { outline(p, A); continue; }
+				if (p.sprite)
+				{
+					int Ya, Yb, Xa, Xb; srect(p, Ya, Yb, Xa, Xb);
+					for (int Y = Ya; Y < Yb; Y++)
+					{
+						const uint32_t *e0 = &elist[0];
+						const uint32_t *eb = e0 + rowstart[Y - yb0], *ee = e0 + rowstart[Y - yb0 + 1];
+						const uint8_t *cls = &m_hd_cls[(Y / SY) * W];
+						for (const uint32_t *it = std::lower_bound(eb, ee, uint32_t(Y) * HW + Xa); it != ee && int(*it - uint32_t(Y) * HW) <= Xb; ++it)
+						{
+							const int x = int(*it - uint32_t(Y) * HW);
+							if (cls[x / SX] == 2) continue;
+							uint32_t *sm = &bs.ss[size_t(it - e0) * AA];
+							for (int k = 0; k < A; k++)
+							{
+								const double v = (Y + (k + 0.5) / A) / SY - (p.dy0 - 0x28);
+								for (int j = 0; j < A; j++)
+								{
+									const uint8_t pen = spen(p, (x + (j + 0.5) / A) / SX - p.dx0, v);
+									if (pen) sm[k * A + j] = pc(bank + pen);
+								}
+							}
+						}
+					}
+					continue;
+				}
+				const int pat = pattern(p.flags);
+				const uint32_t col = pc(bank + p.pen);
+				int Ya, Yb; rows(p, Ya, Yb);
+				for (int Y = Ya; Y < Yb; Y++, sp += 2 * A)
+				{
+					const uint32_t *e0 = &elist[0];
+					const uint32_t *eb = e0 + rowstart[Y - yb0], *ee = e0 + rowstart[Y - yb0 + 1];
+					if (eb == ee) continue;
+					const uint8_t *cls = &m_hd_cls[(Y / SY) * W];
+					for (int k = 0; k < A; k++)
+					{
+						const int X0 = sp[2 * k], X1 = sp[2 * k + 1];
+						if (X1 < X0) continue;
+						const uint32_t *it = std::lower_bound(eb, ee, uint32_t(Y) * HW + X0 / A);
+						for (; it != ee && int(*it - uint32_t(Y) * HW) <= X1 / A; ++it)
+						{
+							const int x = int(*it - uint32_t(Y) * HW);
+							if (cls[x / SX] == 2) continue;
+							uint32_t *sm = &bs.ss[size_t(it - e0) * AA + k * A];
+							for (int j = 0; j < A; j++)
+							{
+								const int X = x * A + j;
+								if (X >= X0 && X <= X1) shade(sm[j], pat, col);
+							}
+						}
+					}
+				}
+			}
+			for (size_t i = 0; i < ne; i++)
+			{
+				const uint32_t *sm = &bs.ss[i * AA];
+				uint32_t rs = 0, gs = 0, bsum = 0;
+				for (int k = 0; k < AA; k++) { rs += (sm[k] >> 16) & 0xff; gs += (sm[k] >> 8) & 0xff; bsum += sm[k] & 0xff; }
+				const uint32_t e = elist[i];
+				bitmap.pix(e / HW, e % HW) = 0xff000000 | ((rs / AA) << 16) | ((gs / AA) << 8) | (bsum / AA);
+				m_hd_eidx[e] = -1;
+			}
+		};
+		std::vector<std::thread> th;
+		for (int i = 1; i < nb; i++)
+			th.emplace_back(band, std::ref(m_hd_band[i]), HP * i / nb, HP * (i + 1) / nb);
+		band(m_hd_band[0], 0, HP / nb);
+		for (std::thread &t : th) t.join();
+		if (dbg && aa && (m_hd_frames % 300) == 0)
+		{
+			size_t ne = 0;
+			for (int i = 0; i < nb; i++) ne += m_hd_band[i].elist.size();
+			std::fprintf(stderr, "stun60 HD AA: %zu edge pixels of %d, %d threads\n", ne, HW * HP, nb);
+		}
+	}
+	if (dbg)
+	{
+		auto t2 = std::chrono::steady_clock::now();
+		t_sum[0] += std::chrono::duration<double, std::milli>(t1 - t0).count();
+		t_sum[1] += std::chrono::duration<double, std::milli>(t2 - t1).count();
+		if (++t_n == 600)
+		{
+			std::fprintf(stderr, "stun60 HD timing: classify+scale %.2f ms, polygons %.2f ms per frame\n", t_sum[0] / t_n, t_sum[1] / t_n);
+			t_sum[0] = t_sum[1] = 0; t_n = 0;
+		}
+	}
+}
+
+// Mark the low-res pixels where hd_draw_bg will draw this image (same rules, per low-res pixel).
+void harddriv_state::hd_mark_bg(const s60hd_blit &b, const s60hd_bg &bg, int W, int H)
+{
+	const int SX = m_hd_sx, SY = m_hd_sy;
+	const bool transp = b.flags & 0x20;
+	const int IW = bg.w * SX, top = b.y - 0x28 + (b.x < 0 ? 1 : 0);
+	const int r0 = std::max(top, 0), r1 = std::min(top + int(bg.h), H) - 1;
+	const int lx0 = std::max<int>(b.x, 0), lx1 = std::min<int>(b.x + bg.w, W) - 1;
+	for (int r = r0; r <= r1; r++)
+	{
+		const uint16_t *src = &m_hd_done[r * 512];
+		const uint8_t *cls = &m_hd_cls[r * W];
+		const uint8_t *prow = &bg.pen[size_t(r - top) * SY * IW];
+		for (int lx = lx0; lx <= lx1; lx++)
+		{
+			const int c = cls[lx];
+			const uint8_t p = prow[(lx - b.x) * SX];
+			if (c == 2 || (transp && p == 0) || (c == 0 && (src[lx] & 0xff) != p)) continue;
+			m_hd_img[r * W + lx] = 1;
+		}
+	}
+}
+
+// Draw one HD background image at its blit position. An HD pixel is used where the low-res frame shows this image's pen
+// at that pixel (so the HUD, text and anything else drawn later stay), or where a 3D polygon covers it (the polygon pass
+// draws over it; this only shows at the HD polygon edges). Colours follow the live palette: the upscaled colour is
+// scaled by live / reference for its pen, so fades and colour cycling still work.
+void harddriv_state::hd_draw_bg(bitmap_rgb32 &bitmap, const s60hd_blit &b, const s60hd_bg &bg, int W, int H)
+{
+	const int SX = m_hd_sx, SY = m_hd_sy, bank = m_hd_bank * 256;
+	const bool transp = b.flags & 0x20;
+	const rgb_t *pens = m_hd_pal.data();
+	const int npens = int(m_hd_pal.size());
+	int fac[256][3]; bool same = true;
+	for (uint8_t i : bg.used)
+	{
+		const int v = bank + i;
+		const rgb_t live = pens[v < npens ? v : 0];
+		const int l[3] = { live.r(), live.g(), live.b() };
+		for (int c = 0; c < 3; c++)
+		{
+			const int r = bg.ref[i][c];
+			fac[i][c] = r ? (l[c] << 8) / r : -l[c] - 1;     // negative = reference was 0: use the live value
+			if (l[c] != r) same = false;
+		}
+	}
+	// the game's blit puts an image that starts left of the screen (x < 0) one line lower (measured: 100% match)
+	const int IW = bg.w * SX, top = b.y - 0x28 + (b.x < 0 ? 1 : 0);
+	const int r0 = std::max(top, 0), r1 = std::min(top + int(bg.h), H) - 1;
+	const int lx0 = std::max<int>(b.x, 0), lx1 = std::min<int>(b.x + bg.w, W) - 1;
+	if (r1 < r0 || lx1 < lx0) return;
+	for (int r = r0; r <= r1; r++)
+	{
+		const uint16_t *src = &m_hd_done[r * 512];
+		const uint8_t *cls = &m_hd_cls[r * W];
+		for (int yy = 0; yy < SY; yy++)
+		{
+			const int Y = r * SY + yy, iy = (r - top) * SY + yy;
+			uint32_t *d = &bitmap.pix(Y);
+			const uint32_t *srow = &bg.rgb[size_t(iy) * IW];
+			const uint8_t *prow = &bg.pen[size_t(iy) * IW];
+			for (int lx = lx0; lx <= lx1; lx++)
+			{
+				const int c = cls[lx];
+				if (c == 2) continue;
+				const int ix0 = (lx - b.x) * SX;
+				const uint8_t p = prow[ix0];            // the low-res pen of the image at this pixel
+				if (transp && p == 0) continue;
+				if (c == 0 && (src[lx] & 0xff) != p) continue;     // something else is on screen here
+				const uint8_t *xm = &m_hd_xm[size_t(Y) * W * SX + lx * SX];
+				for (int xx = 0; xx < SX; xx++)
+				{
+					if (xm[xx]) continue;        // xBR-smoothed 2D drawn over the image here
+					uint32_t v = srow[ix0 + xx];
+					if (!same)
+					{
+						const int pi = prow[ix0 + xx];
+						{
+							int ch[3] = { int((v >> 16) & 0xff), int((v >> 8) & 0xff), int(v & 0xff) };
+							for (int k = 0; k < 3; k++)
+								ch[k] = fac[pi][k] >= 0 ? std::min(255, (ch[k] * fac[pi][k]) >> 8) : -fac[pi][k] - 1;
+							v = (ch[0] << 16) | (ch[1] << 8) | ch[2];
+						}
+					}
+					d[lx * SX + xx] = v | 0xff000000;
+				}
+				m_hd_bg_drawn += SX;
+			}
+		}
+	}
+}
+
+/*************************************
+ *
+ *  stun60 HD: background pack builder (first run, in a background thread)
+ *
+ *  The 68010 program ROM holds the background images as compressed streams (pointer table $BFE00; the game's own
+ *  unpacker is at $022766) and their palettes (pointer table $48068: 16 RGB triplets for pens 240-255). Each gameplay
+ *  background is unpacked, padded with its wrap-around neighbour, upscaled 4x by Real-ESRGAN (realesrgan-x4plus, run as
+ *  a low-priority child process), resampled to SX x SY with Lanczos-3 and saved as a .s60bg file in the pack folder,
+ *  then handed to the emulation thread. Same algorithm and file format as hdpack/build_pack.py.
+ *
+ *************************************/
+
+namespace {
+
+struct s60_img { int stream, index, w, h, prio, pre = 1; bool dark; std::vector<uint8_t> px; uint8_t pal[256][3]; uint32_t key, palkey; std::vector<uint8_t> left, right; int lw, rw; };
+
+uint32_t s60_fnv(const uint8_t *p, size_t n)
+{
+	uint32_t h = 2166136261u;
+	for (size_t i = 0; i < n; i++) h = (h ^ p[i]) * 16777619u;
+	return h;
+}
+
+// unpack one stream (see hdpack/stunbg.py for the format); returns false on a malformed stream
+bool s60_unpack(const std::vector<uint8_t> &rom, uint32_t a, std::vector<uint8_t> &out)
+{
+	uint8_t t[16] = { 0 };
+	if (a >= rom.size() || rom[a] != 0) return false;
+	while (a < rom.size() && out.size() < 0x80000)
+	{
+		const uint8_t c = rom[a++], n = c & 0x3f;
+		if (c & 0x80)
+		{
+			if (!n || a >= rom.size()) return false;
+			const uint8_t b = rom[a++];
+			for (int i = 0; i < n; i++)
+			{
+				if (c & 0x40) { out.push_back(t[b >> 4]); out.push_back(t[b & 15]); }
+				else out.push_back(b);
+			}
+		}
+		else if (c & 0x40)
+		{
+			if (!n) return true;
+			for (int i = 0; i < n && a < rom.size(); i++, a++) { out.push_back(t[rom[a] >> 4]); out.push_back(t[rom[a] & 15]); }
+		}
+		else if (n)
+			for (int i = 0; i < n && a < rom.size(); i++) out.push_back(rom[a++]);
+		else
+		{
+			if (a + 16 > rom.size()) return false;
+			std::memcpy(t, &rom[a], 16); a += 16;
+		}
+	}
+	return false;
+}
+
+// unpack every image of stream n (GSP byte order); empty if the stream is not valid
+std::vector<s60_img> s60_stream_images(const std::vector<uint8_t> &rom, int n)
+{
+	auto l32 = [&rom] (uint32_t a) { return a + 4 <= rom.size() ? (uint32_t(rom[a]) << 24) | (rom[a + 1] << 16) | (rom[a + 2] << 8) | rom[a + 3] : 0u; };
+	std::vector<s60_img> ims;
+	const uint32_t p = l32(0xbfe00 + 4 * n);
+	std::vector<uint8_t> buf;
+	if (!p || p >= rom.size() || !s60_unpack(rom, p, buf)) return ims;
+	if (buf.size() & 1) buf.push_back(0);
+	for (size_t i = 0; i + 1 < buf.size(); i += 2) std::swap(buf[i], buf[i + 1]);   // 68010 big-endian words -> GSP order
+	for (size_t o = 0; o + 12 <= buf.size(); )
+	{
+		const int h = buf[o] | (buf[o + 1] << 8), w = buf[o + 2] | (buf[o + 3] << 8);
+		if (w <= 0 || w > 1024 || h <= 0 || h > 512 || o + 12 + size_t(w) * h > buf.size()) break;
+		s60_img im;
+		im.stream = n; im.index = int(ims.size()); im.w = w; im.h = h; im.prio = 0;
+		im.px.assign(buf.begin() + o + 12, buf.begin() + o + 12 + size_t(w) * h);
+		std::memset(im.pal, 0, sizeof(im.pal));
+		im.key = s60_fnv(im.px.data(), im.px.size());
+		ims.push_back(std::move(im));
+		o += 12 + size_t(w) * h;
+	}
+	for (size_t i = 0; i < ims.size(); i++)      // wrap-around neighbours (panoramas are drawn as image i next to image i+1)
+	{
+		const s60_img &l = ims[(i + ims.size() - 1) % ims.size()], &r = ims[(i + 1) % ims.size()];
+		const bool same_h = l.h == ims[i].h && r.h == ims[i].h;
+		ims[i].left = same_h ? l.px : ims[i].px; ims[i].lw = same_h ? l.w : ims[i].w;
+		ims[i].right = same_h ? r.px : ims[i].px; ims[i].rw = same_h ? r.w : ims[i].w;
+	}
+	return ims;
+}
+
+// The header-less streams are whole screens the game copies straight into the frame buffer (no display-list blit):
+// 512 pixels wide, 240, 208 or 32 rows. Seen on screen at row 0 (the HUD panel: row 208). Palettes, found by matching
+// the live palette against the ROM: the level-1 base palette $44630 for everything, the title's own colours (pens
+// 0-223) at $461F0, and the image palette $48068[n] (where there is one) from its first 16-pen block >= 200.
+// prio: the title, HUD and course map go in the builder's first batch (seen within seconds of a first launch).
+std::vector<s60_img> s60_fullscreen_images(const std::vector<uint8_t> &rom)
+{
+	auto l32 = [&rom] (uint32_t a) { return a + 4 <= rom.size() ? (uint32_t(rom[a]) << 24) | (rom[a + 1] << 16) | (rom[a + 2] << 8) | rom[a + 3] : 0u; };
+	static const struct { int n, prio; } FS[] = { { 2, 0 }, { 1, 0 }, { 25, 0 }, { 3, 400 }, { 24, 400 }, { 26, 400 }, { 27, 400 }, { 28, 400 } };
+	std::vector<s60_img> res;
+	if (rom.size() < 0x47406 + 0x300) return res;
+	for (const auto &e : FS)
+	{
+		const uint32_t p = l32(0xbfe00 + 4 * e.n);
+		std::vector<uint8_t> buf;
+		if (!p || p >= rom.size() || !s60_unpack(rom, p, buf)) continue;
+		if (buf.size() & 1) buf.push_back(0);
+		for (size_t i = 0; i + 1 < buf.size(); i += 2) std::swap(buf[i], buf[i + 1]);
+		const int h = int(buf.size() / 512);
+		if (buf.size() % 512 || (h != 240 && h != 208 && h != 32)) continue;   // not a whole-screen image
+		s60_img im;
+		im.stream = e.n; im.index = 0; im.w = 512; im.h = h; im.prio = e.prio;
+		im.pre = 2;     // pixel-doubled before Real-ESRGAN: small lettering stays correct (direct: S -> 9 on the course map)
+		im.px.assign(buf.begin(), buf.end());
+		im.key = s60_fnv(im.px.data(), im.px.size());
+		std::memcpy(im.pal, &rom[0x44630], 768);
+		const std::vector<uint8_t> used = s60_used_pens(im.px);
+		if (used.empty()) continue;
+		if (e.n == 2) std::memcpy(im.pal, &rom[0x461f0], 224 * 3);
+		const uint32_t ip = l32(0x48068 + 4 * e.n);
+		// the image palette starts at the 16-pen block of its first pen >= 200 (s25: 224, s26-28: 208, s3: 240); lower
+		// pens come from the base palette (s25's pen 29 is a flashing light)
+		int p0 = 256;
+		for (uint8_t q : used) if (q >= 200) { p0 = q & ~15; break; }
+		if (ip && p0 < 256 && ip + (256 - p0) * 3 <= rom.size()) std::memcpy(im.pal[p0], &rom[ip], (256 - p0) * 3);
+		im.palkey = s60_palkey(im.pal, used);
+		size_t darkpx = 0;
+		for (uint8_t q : im.px) darkpx += std::max({ im.pal[q][0], im.pal[q][1], im.pal[q][2] }) < 48;
+		im.dark = darkpx * 2 > im.px.size();
+		// padding for the upscaler: repeat the edge columns (these are not panoramas)
+		im.lw = im.rw = 1;
+		im.left.resize(h); im.right.resize(h);
+		for (int y = 0; y < h; y++) { im.left[y] = im.px[y * 512]; im.right[y] = im.px[y * 512 + 511]; }
+		res.push_back(std::move(im));
+	}
+	return res;
+}
+
+// Every background the game shows, with the palette it is shown with, in play order. Per level L (ROM tables):
+// skyline = image $4CB1C[L], between-level screen = image $4CB36[L]; pens 240-255 come from the image's palette
+// ($48068[n]: 16 RGB), pens 0-239 from the level's base palette ($47406[L]: 256 RGB, routine $0296AA).
+std::vector<s60_img> s60_find_images(const std::vector<uint8_t> &rom)
+{
+	auto l32 = [&rom] (uint32_t a) { return a + 4 <= rom.size() ? (uint32_t(rom[a]) << 24) | (rom[a + 1] << 16) | (rom[a + 2] << 8) | rom[a + 3] : 0u; };
+	std::vector<s60_img> res;
+	std::vector<uint64_t> seen;
+	// skylines first (play order), then the level-start screens, then any other image that uses only its own
+	// 16 colours (attract mode, ending)
+	for (int pass = 0; pass < 3; pass++)
+		for (int L = 0; L < (pass == 2 ? 127 : 26); L++)
+		{
+			const int n = pass == 2 ? L + 1 : rom[(pass ? 0x4cb36 : 0x4cb1c) + L];
+			const uint32_t ip = l32(0x48068 + 4 * n), lp = l32(0x47406 + 4 * (pass == 2 ? 0 : L));
+			if (n <= 0 || n >= 128 || !ip || ip + 48 > rom.size() || !lp || lp + 768 > rom.size()) continue;
+			for (s60_img &im : s60_stream_images(rom, n))
+			{
+				std::memcpy(im.pal, &rom[lp], 768);
+				std::memcpy(im.pal[240], &rom[ip], 48);
+				const std::vector<uint8_t> used = s60_used_pens(im.px);
+				if (used.empty() || (pass != 1 && used.front() < 240)) continue;   // skylines use only their own 16 colours
+				if (used.front() >= 240) std::memset(im.pal, 0, 240 * 3);          // (so one variant serves every level)
+				im.palkey = s60_palkey(im.pal, used);
+				// dark images (night city, galaxy): the detail is small points of light, which the general model wipes
+				// out; the anime-video model keeps them (compared on the night city)
+				size_t darkpx = 0;
+				for (uint8_t p : im.px) darkpx += std::max({ im.pal[p][0], im.pal[p][1], im.pal[p][2] }) < 48;
+				im.dark = darkpx * 2 > im.px.size();
+				const uint64_t id = (uint64_t(im.key) << 32) | im.palkey;
+				if (std::find(seen.begin(), seen.end(), id) != seen.end()) continue;
+				seen.push_back(id);
+				im.prio = pass * 100 + L;
+				res.push_back(std::move(im));
+			}
+		}
+	return res;
+}
+
+// separable Lanczos-3 resample of an RGB float image (PIL-style: the kernel widens when shrinking)
+void s60_resample(const std::vector<float> &src, int sw, int sh, std::vector<float> &dst, int dw, int dh)
+{
+	auto pass = [] (const std::vector<float> &in, int iw, int ih, int ow, bool horiz) {
+		const int inlen = horiz ? iw : ih, outlen = ow, other = horiz ? ih : iw;
+		const double scale = double(inlen) / outlen, fs = std::max(scale, 1.0), support = 3.0 * fs;
+		std::vector<float> out(size_t(horiz ? ow * ih : iw * ow) * 3);
+		auto lanczos = [] (double x) { x = std::fabs(x); if (x < 1e-9) return 1.0; if (x >= 3.0) return 0.0;
+			const double px = 3.14159265358979323846 * x; return 3.0 * std::sin(px) * std::sin(px / 3.0) / (px * px); };
+		for (int o = 0; o < outlen; o++)
+		{
+			const double c = (o + 0.5) * scale;
+			const int i0 = std::max(int(std::floor(c - support)), 0), i1 = std::min(int(std::ceil(c + support)), inlen - 1);
+			std::vector<double> wts; double sum = 0;
+			for (int i = i0; i <= i1; i++) { const double w = lanczos((i + 0.5 - c) / fs); wts.push_back(w); sum += w; }
+			for (int q = 0; q < other; q++)
+				for (int ch = 0; ch < 3; ch++)
+				{
+					double acc = 0;
+					for (int i = i0; i <= i1; i++)
+					{
+						const size_t si = horiz ? (size_t(q) * iw + i) : (size_t(i) * iw + q);
+						acc += in[si * 3 + ch] * wts[i - i0];
+					}
+					const size_t di = horiz ? (size_t(q) * ow + o) : (size_t(o) * iw + q);
+					out[di * 3 + ch] = float(acc / sum);
+				}
+		}
+		return out;
+	};
+	std::vector<float> tmp = pass(src, sw, sh, dw, true);
+	dst = pass(tmp, dw, sh, dh, false);
+}
+
+bool s60_run_esrgan(const std::string &exe, const char *model, const std::filesystem::path &in, const std::filesystem::path &out, const std::filesystem::path &log)
+{
+	const std::filesystem::path models = std::filesystem::path(exe).parent_path() / "models";
+#if defined(_WIN32)
+	std::wstring cmd = L"\"" + std::filesystem::path(exe).wstring() + L"\" -i \"" + in.wstring() + L"\" -o \"" + out.wstring()
+			+ L"\" -n " + std::filesystem::path(model).wstring() + L" -s 4 -m \"" + models.wstring() + L"\"";
+	STARTUPINFOW si = { sizeof(si) }; PROCESS_INFORMATION pi;
+	si.dwFlags = STARTF_USESHOWWINDOW; si.wShowWindow = SW_HIDE;
+	if (!CreateProcessW(nullptr, cmd.data(), nullptr, nullptr, FALSE, BELOW_NORMAL_PRIORITY_CLASS | CREATE_NO_WINDOW, nullptr, nullptr, &si, &pi))
+		return false;
+	WaitForSingleObject(pi.hProcess, INFINITE);
+	DWORD code = 1; GetExitCodeProcess(pi.hProcess, &code);
+	CloseHandle(pi.hThread); CloseHandle(pi.hProcess);
+	return code == 0;
+#else
+	const std::string cmd = "nice -n 19 \"" + exe + "\" -i \"" + in.string() + "\" -o \"" + out.string()
+			+ "\" -n " + model + " -s 4 -m \"" + models.string() + "\" >\"" + log.string() + "\" 2>&1";
+	return std::system(cmd.c_str()) == 0;
+#endif
+}
+
+bool s60_write_png(const std::filesystem::path &path, const s60_img &im, int pad)
+{
+	const int W = im.w + 2 * pad, H = im.h + 2 * pad, k = im.pre;
+	bitmap_rgb32 bm(W * k, H * k);
+	for (int Y = 0; Y < H * k; Y++)
+		for (int X = 0; X < W * k; X++)
+		{
+			const int y = Y / k, x = X / k;
+			const int sy = std::clamp(y - pad, 0, im.h - 1), sx = x - pad;
+			const uint8_t p = sx < 0 ? im.left[sy * im.lw + std::max(im.lw + sx, 0)] : sx >= im.w ? im.right[sy * im.rw + std::min(sx - im.w, im.rw - 1)] : im.px[sy * im.w + sx];
+			const uint8_t *c = im.pal[p];
+			bm.pix(Y, X) = rgb_t(0xff, c[0], c[1], c[2]);
+		}
+	util::core_file::ptr f;
+	if (util::core_file::open(path.string(), OPEN_FLAG_WRITE | OPEN_FLAG_CREATE, f)) return false;
+	return !util::png_write_bitmap(*f, nullptr, bm, 0, nullptr);
+}
+
+void s60_build_thread(std::shared_ptr<harddriv_state::s60hd_build> st, std::vector<uint8_t> rom, std::string pack, std::string exe,
+		int SX, int SY, std::vector<uint64_t> have)
+{
+	namespace fs = std::filesystem;
+	// lowest priority: the game must keep its frame rate while this runs
+#if defined(_WIN32)
+	SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_LOWEST);
+#else
+	setpriority(PRIO_PROCESS, 0, 19);     // Linux: per-thread nice value for the calling thread
+#endif
+	const int PAD = 16;
+	const auto t0 = std::chrono::steady_clock::now();
+	auto secs = [&t0] { return std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count(); };
+	std::vector<s60_img> todo, all = s60_fullscreen_images(rom), bgs = s60_find_images(rom);
+	// whole screens (title, HUD, course map) share the first batch with level 1's skyline (prio 0); the rest go last
+	std::stable_partition(all.begin(), all.end(), [] (const s60_img &i) { return i.prio == 0; });
+	auto split = std::find_if(all.begin(), all.end(), [] (const s60_img &i) { return i.prio != 0; });
+	std::vector<s60_img> late(std::make_move_iterator(split), std::make_move_iterator(all.end()));
+	all.erase(split, all.end());
+	for (auto &im : bgs) all.push_back(std::move(im));
+	for (auto &im : late) all.push_back(std::move(im));
+	for (auto &im : all)
+		if (std::find(have.begin(), have.end(), (uint64_t(im.key) << 32) | im.palkey) == have.end())
+			todo.push_back(std::move(im));
+	{ std::lock_guard<std::mutex> g(st->lock); st->total = int(todo.size()); }
+	std::error_code ec;
+	// pack files from before v1.5 (uncompressed, 3x the size): rewrite them compressed (same images)
+	{
+		int conv = 0;
+		for (const auto &e : fs::directory_iterator(pack, ec))
+		{
+			if (e.path().extension() != ".s60bg") continue;
+			uint32_t key; harddriv_state::s60hd_bg bg; bool old = false;
+			if (s60_read_bg(e.path(), SX, SY, key, bg, &old) && old && s60_write_bg(e.path(), key, SX, SY, bg)) conv++;
+		}
+		if (conv) std::fprintf(stderr, "stun60: HD pack: %d older files rewritten compressed (%.1f s)\n", conv, secs());
+	}
+	const fs::path work = fs::path(pack) / "_work";
+	if (todo.empty() || !fs::exists(exe, ec)) { std::lock_guard<std::mutex> g(st->lock); st->finished = true; return; }
+	std::fprintf(stderr, "stun60: building %d HD backgrounds in the background (%s)\n", int(todo.size()), exe.c_str());
+	// batches (one Real-ESRGAN start each, ~5 s of model loading): the first course's skyline (ready in seconds),
+	// then the rest grouped by model
+	size_t first = 0;
+	while (first < todo.size() && todo[first].prio == todo[0].prio) first++;
+	std::stable_sort(todo.begin() + first, todo.end(), [] (const s60_img &a, const s60_img &b) { return a.dark < b.dark; });
+	for (size_t b0 = 0; b0 < todo.size(); )
+	{
+		size_t b1 = b0 + 1;
+		while (b1 < todo.size() && todo[b1].dark == todo[b0].dark && (b0 >= first || b1 < first)) b1++;
+		const char *model = todo[b0].dark ? "realesr-animevideov3" : "realesrgan-x4plus";
+		fs::remove_all(work, ec);
+		fs::create_directories(work / "in", ec); fs::create_directories(work / "out", ec);
+		for (size_t i = b0; i < b1; i++)
+			s60_write_png(work / "in" / util::string_format("%d.png", int(i)), todo[i], PAD);
+		const bool ok = s60_run_esrgan(exe, model, work / "in", work / "out", fs::path(pack) / "esrgan.log");
+		for (size_t i = b0; i < b1 && ok; i++)
+		{
+			const s60_img &im = todo[i];
+			util::core_file::ptr f; bitmap_argb32 up;
+			if (util::core_file::open((work / "out" / util::string_format("%d.png", int(i))).string(), OPEN_FLAG_READ, f) || util::png_read_bitmap(*f, up))
+				continue;
+			const int W = im.w + 2 * PAD, H = im.h + 2 * PAD;
+			const int UW = 4 * im.pre * W, UH = 4 * im.pre * H;
+			if (up.width() != UW || up.height() != UH) continue;
+			std::vector<float> src(size_t(UW) * UH * 3), dst;
+			for (int y = 0; y < UH; y++)
+				for (int x = 0; x < UW; x++)
+				{
+					const rgb_t c = up.pix(y, x); float *d = &src[(size_t(y) * UW + x) * 3];
+					d[0] = c.r(); d[1] = c.g(); d[2] = c.b();
+				}
+			s60_resample(src, UW, UH, dst, W * SX, H * SY);
+			harddriv_state::s60hd_bg bg;
+			bg.w = im.w; bg.h = im.h;
+			std::memcpy(bg.ref, im.pal, sizeof(bg.ref));
+			const int IW = im.w * SX, IH = im.h * SY;
+			bg.rgb.resize(size_t(IW) * IH); bg.pen.resize(size_t(IW) * IH);
+			for (int y = 0; y < IH; y++)
+				for (int x = 0; x < IW; x++)
+				{
+					const float *c = &dst[(size_t(y + PAD * SY) * W * SX + x + PAD * SX) * 3];
+					auto q = [] (float v) { return uint32_t(std::clamp(int(std::lround(v)), 0, 255)); };
+					bg.rgb[size_t(y) * IW + x] = 0xff000000 | (q(c[0]) << 16) | (q(c[1]) << 8) | q(c[2]);
+					bg.pen[size_t(y) * IW + x] = im.px[(y / SY) * im.w + x / SX];
+				}
+			s60_write_bg(fs::path(pack) / util::string_format("s%02d_%d_%08x.s60bg", im.stream, im.index, im.palkey), im.key, SX, SY, bg);
+			std::lock_guard<std::mutex> g(st->lock);
+			st->ready.emplace_back(im.key, std::move(bg));
+			st->done++;
+			std::fprintf(stderr, "stun60: HD background %d/%d ready (s%02d_%d %08x%s, %.1f s)\n", st->done, st->total, im.stream, im.index, im.palkey, im.dark ? " dark" : "", secs());
+		}
+		if (!ok) { std::fprintf(stderr, "stun60: Real-ESRGAN failed (see esrgan.log in the pack folder); keeping the original backgrounds\n"); break; }
+		b0 = b1;
+	}
+	fs::remove_all(work, ec);
+	std::lock_guard<std::mutex> g(st->lock);
+	st->finished = true;
+	std::fprintf(stderr, "stun60: HD background builder finished (%d of %d, %.1f s)\n", st->done, st->total, secs());
+}
+
+} // anonymous namespace
+
+void harddriv_state::hd_start_builder()
+{
+	const char *pack = std::getenv("STUN60_HDPACK"), *exe = std::getenv("STUN60_ESRGAN");
+	if (!pack || !*pack || !exe || !*exe)
+		return;
+	memory_region *rgn = memregion("maincpu");
+	if (!rgn || rgn->bytes() < 0xc0000)
+		return;
+	// ROM bytes in 68010 (big-endian) order, whatever order the region is stored in
+	std::vector<uint8_t> rom(rgn->bytes());
+	const uint8_t *b = rgn->base();
+	// image pointer table entry 1 is 0x00060002: bytes 00 06 00 02 in 68010 order, 06 00 02 00 if stored swapped
+	const bool swap = !(b[0xbfe04] == 0x00 && b[0xbfe05] == 0x06 && b[0xbfe06] == 0x00 && b[0xbfe07] == 0x02);
+	for (size_t i = 0; i < rom.size(); i++)
+		rom[i] = b[swap ? (i ^ 1) : i];
+	std::error_code ec;
+	std::filesystem::create_directories(pack, ec);
+	std::vector<uint64_t> have;
+	for (const auto &kv : m_hd_bgs)
+		for (const s60hd_bg &v : kv.second) have.push_back((uint64_t(kv.first) << 32) | v.palkey);
+	m_hd_build = std::make_shared<s60hd_build>();
+	std::thread(s60_build_thread, m_hd_build, std::move(rom), std::string(pack), std::string(exe), m_hd_sx, m_hd_sy, std::move(have)).detach();
+}
+
+// emulation thread: take the images the builder has finished (never blocks)
+void harddriv_state::hd_take_built()
+{
+	if (!m_hd_build) return;
+	std::unique_lock<std::mutex> g(m_hd_build->lock, std::try_to_lock);
+	if (!g.owns_lock()) return;
+	for (auto &kv : m_hd_build->ready)
+		hd_add_bg(kv.first, std::move(kv.second));
+	m_hd_build->ready.clear();
+	if (m_hd_build->finished)
+	{
+		g.unlock();
+		m_hd_build.reset();
+	}
+}
